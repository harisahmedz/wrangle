# ============================================================
# Wrangle — environment template
# Copy to `.env` for local dev:  cp .env.example .env
# NEVER commit the real .env. Production values live in
# Vercel → Project → Settings → Environment Variables.
# ============================================================

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database (Neon Postgres) ────────────────────────────────
# Neon dashboard → your project → Connection Details.
# POOLED string (host contains "-pooler") → app runtime queries.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/wrangle?sslmode=require"
# DIRECT (non-pooled) string → migrations only (drizzle-kit needs it).
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/wrangle?sslmode=require"

# ── Auth.js v5 ──────────────────────────────────────────────
# Generate a secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Google OAuth — console.cloud.google.com → APIs & Services → Credentials
# → Create OAuth client ID (type: Web application)
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth — github.com/settings/developers → New OAuth App
# Authorization callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ── Cloudinary (signed uploads) ─────────────────────────────
# cloudinary.com/console → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Rate limiting (Upstash Redis) — phase 4 ─────────────────
# console.upstash.com → create REST database
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Error tracking (Sentry) — phase 0.5 ─────────────────────
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=""
